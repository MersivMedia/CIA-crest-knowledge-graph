.venv/
__pycache__/
*.pyc
.env
*.key
*credentials*.json
google_token.json

# Data — never commit the corpus or derived state
*.zip
*.db
# ...except the manifest, which is mirrored here deliberately (see manifest/README.md)
!manifest/crest1.zip
!manifest/crest2.zip
*.pdf
*.jpg
benchmark_results.json
coverage.json
quarantine/
crest_bench/
PRD.html

# Bench readings and run outputs ARE committed (small JSON/logs) so tests build on each other.
# Page images and PDFs stay out (*.jpg / *.pdf above); they are published as release assets.
!bench/store/
!bench/runs/
